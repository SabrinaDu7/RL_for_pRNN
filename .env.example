# Copy to .env and adjust. Every value here is RELATIVE, so a fresh clone works
# anywhere; the tracked .env this replaces hardcoded one machine's home
# directory and any other clone wrote into a path naming that user.
#
# RL_STORAGE is the single source of truth for where run outputs land.
RL_STORAGE="./outputs"
ROOT_DIR="."

# Checkpoint directories a task or an analysis reads. Point each at a run
# DIRECTORY; the two filenames inside (predictiveNet_state.pt, status.pt) are
# derived. See curious_george/utils/dev_env.py::get_ckpt_env_vars.
CUR_CKPT_DIR="./outputs/ckpts/<a-curious-agent-run>"
RAND_CKPT_DIR="./outputs/ckpts/<a-random-agent-run>"
